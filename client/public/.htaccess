# fix: remove trailing dollar sign redirect bug from htaccess
RewriteEngine On
RewriteCond %{REQUEST_URI} ^/$$ [OR]
RewriteCond %{QUERY_STRING} ^$
RewriteRule ^ https://maqsadalhramein.com/ [R=301,L]

<IfModule mod_rewrite.c>
  RewriteBase /
  # Standard SPA redirect for Apache
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
